# Copiar a .env y completar. El archivo .env NO va al repositorio.

# Desarrollo local sin Docker (por defecto)
# DATABASE_URL=sqlite+aiosqlite:///./areatecnica.db

# Con Docker Compose / producción
DATABASE_URL=postgresql+asyncpg://postgres:12345678@localhost:5432/analisisdeportivo

# Clave de firma de los JWT. Generar una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-antes-de-desplegar

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# Recuperación de contraseña (HU-52)
RESET_TOKEN_MINUTES=60
# Base de los enlaces que llegan por correo: la URL de la web
WEB_URL=http://localhost:5173

# Correo saliente. Si SMTP_HOST queda vacío, el correo no se envía: se
# escribe en el log del backend (útil en desarrollo para copiar el enlace).
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=Área Técnica <no-responder@areatecnica.local>
