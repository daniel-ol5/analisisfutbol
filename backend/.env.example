# Copiar a .env y completar. El archivo .env NO va al repositorio.

# PostgreSQL 16 (el unico motor soportado: ya no hay SQLite). Con Docker Compose
# la base queda en localhost:5432; completar usuario, clave y nombre de la base.
DATABASE_URL=postgresql+asyncpg://USUARIO:CLAVE@localhost:5432/NOMBRE_BASE

# Clave de firma de los JWT. Generar una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# El worker externo toma la cola. Activar solo para ensayar un worker local.
VISION_AUTO_WORKER=false

# Recuperación de contraseña (HU-52)
RESET_TOKEN_MINUTES=60
# Base de los enlaces que llegan por correo: la URL de la web
WEB_URL=http://localhost:5173

# Correo saliente. Si SMTP_HOST queda vacío, el correo no se envía: se
# escribe en el log del backend (útil en desarrollo para copiar el enlace).
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=Área Técnica <no-responder@areatecnica.local>

# Asistente de uso con IA. La clave va SOLO aqui (nunca en la web ni en el movil).
# Sin clave, o con ASISTENTE_ACTIVO=false, el chat avisa que no esta disponible
# y "Tu progreso" sigue funcionando. El modelo se cambia solo desde aqui.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ASISTENTE_MAX_PREGUNTAS_DIA=30
ASISTENTE_ACTIVO=true
