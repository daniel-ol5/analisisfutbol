# Variables de `docker compose`. Copiar a `.env` (que NO va al repositorio) y completar.
# Ningun valor real se escribe en este archivo ni en docker-compose.yml.
#
# Usar solo letras y numeros en las claves de base de datos: van dentro de una URL.

# Clave del usuario "areatecnica" de PostgreSQL 16 (servicio db).
POSTGRES_PASSWORD=

# Clave de la base exclusiva para pruebas (servicio db_test, perfil "test").
TEST_DB_PASSWORD=

# Firma de los JWT. Generar una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Clave del administrador de demostracion que crea el seed de desarrollo.
DEMO_ADMIN_PASSWORD=

# CU-53 (opcional): habilitar solo donde existan credenciales ADC de Firebase.
FIREBASE_PUSH_HABILITADO=false
FIREBASE_PROJECT_ID=
# No copies el JSON al repositorio. Define esta variable en el entorno del proceso:
# GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/privada/firebase-service-account.json

# Asistente de uso con IA. La clave va SOLO aqui (nunca en la web ni en el movil).
# Sin clave, o con ASISTENTE_ACTIVO=false, el chat avisa que no esta disponible
# y "Tu progreso" sigue funcionando. El modelo se cambia solo desde aqui.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ASISTENTE_MAX_PREGUNTAS_DIA=30
ASISTENTE_ACTIVO=true
