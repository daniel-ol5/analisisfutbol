# Variables de `docker compose`. Copiar a `.env` (que NO va al repositorio) y completar.
# Ningun valor real se escribe en este archivo ni en docker-compose.yml.
#
# Usar solo letras y numeros en las claves de base de datos: van dentro de una URL.

# Clave del usuario "areatecnica" de PostgreSQL 16 (servicio db).
POSTGRES_PASSWORD=

# Clave de la base exclusiva para pruebas (servicio db_test, perfil "test").
TEST_DB_PASSWORD=

# Firma de los JWT. Generar una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Clave del administrador de demostracion que crea el seed de desarrollo.
DEMO_ADMIN_PASSWORD=
